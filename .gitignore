# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# AI-only local context
docs/context.md

# Logs and runtime output
*.log
logs/
log/

# Local backups created by the GUI migration / Wipe Data steps
backups/

# Raw video clips are large and eat Git LFS quota — keep them local, off GitHub.
# (This only stops NEW clips from being committed; clips already tracked must be
# removed with `git rm --cached` to leave the remote.)
*.mov
*.MOV

# EXCEPTION: demo/documentation clips under docs/ ARE kept (LFS-tracked) so they
# show up on GitHub. These negations must stay AFTER the *.mov/*.MOV rules above.
!docs/**/*.mov
!docs/**/*.MOV
!docs/**/*.mp4
!docs/**/*.MP4
!docs/**/*.m4v
!docs/**/*.M4V

# Training pictures/media stay LOCAL only — they are NOT kept on GitHub. Only the
# documentation pictures under docs/images/ are tracked. The labels (.txt), meta,
# dataset.yaml, and trained model weights (models/*.pt) ARE kept in git so the
# dataset and models can be reconstructed; the source frames/clips are transferred
# off-GitHub (rsync from the Pi, local capture) as needed.
data/frames/
data/yolo_dataset/images/
data/rejected/images/
data/retrain_queue/images/
data/raw_videos/
# YOLO training-run artifacts (batch/curve images, per-run weights) — regenerated
# on every training run; the promoted models live in models/*.pt instead.
models/yolo_runs/

# Raspberry Pi / camera captures and generated media
# pi_videos/ is kept OUT of git — videos are too big for GitHub's free LFS budget.
# Transfer Pi recordings to the training computer directly over the LAN instead:
#   scripts/pull_pi_videos.sh   (rsync from the Pi, no GitHub involved)
pi_videos/
captures/
recordings/
*.h264

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
